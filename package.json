{
  "name": "vine-harness",
  "version": "0.1.0",
  "description": "Lightweight AI Agent Harness fusing Trellis lifecycle & hooks, Ponytail pragmatism, and grill-with-docs Socratic brainstorming",
  "main": "bin/vine.js",
  "bin": {
    "vine": "./bin/vine.js",
    "vn": "./bin/vine.js"
  },
  "files": [
    "bin",
    "vine/*.py",
    "vine/assets/__init__.py",
    "vine/assets/*.md",
    "vine/assets/*.js",
    "vine/assets/hooks/*.py",
    "vine/assets/skills/*/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./vine/assets/pi-extension.js"],
    "skills": ["./vine/assets/skills"]
  },
  "scripts": {
    "test": "python -m unittest discover -s tests -p \"test_*.py\" && npm run test:pi",
    "test:pi": "node --test tests/pi-extension.test.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "harness",
    "trellis",
    "ponytail",
    "coding-agent",
    "claude-code",
    "codex",
    "pi-agent",
    "antigravity"
  ],
  "author": "Vine Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  }
}
